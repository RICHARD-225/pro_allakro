# ALLAKRO — variables d'environnement de PRODUCTION (à copier dans backend/.env sur le serveur, jamais dans Git).
# Générer les clés :  python -c "import secrets; print(secrets.token_urlsafe(64))"

DEBUG=False
SECRET_KEY=<clé aléatoire de 64 caractères au moins>
JWT_SIGNING_KEY=<autre clé aléatoire, différente de SECRET_KEY>
ALLOWED_HOSTS=allakro.exemple.com
CORS_ALLOWED_ORIGINS=https://allakro.exemple.com
CSRF_TRUSTED_ORIGINS=https://allakro.exemple.com
FRONTEND_URL=https://allakro.exemple.com

# Base PostgreSQL : un compte dédié aux droits limités à cette base, mot de passe long
DB_NAME=allakro_db
DB_USER=allakro
DB_PASSWORD=<mot de passe long>
DB_HOST=localhost
DB_PORT=5432

# HTTPS : nginx termine TLS et envoie X-Forwarded-Proto ; un seul mandataire de confiance devant l'application
SECURE_PROXY_SSL=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
TRUSTED_PROXY_COUNT=1

# Sessions : jeton d'accès court, renouvelé automatiquement (rotation) ; session maximale de 7 jours
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Cache Redis (compteurs de limitation de débit partagés entre les processus et conservés au redémarrage) : Redis protégé par mot de passe,
# écoutant sur la machine seulement (127.0.0.1) ; si Redis tombe, l'application continue (limites suspendues, blocage de connexion en base actif)
CACHE_BACKEND=redis
CACHE_LOCATION=redis://:<mot de passe Redis>@127.0.0.1:6379/1

# Courrier (mot de passe oublié) : serveur SMTP réel (hébergeur, Brevo, Mailjet, Gmail avec « mot de passe d'application »…)
EMAIL_HOST=smtp.exemple.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<identifiant SMTP>
EMAIL_HOST_PASSWORD=<mot de passe SMTP>
DEFAULT_FROM_EMAIL=ALLAKRO <no-reply@allakro.exemple.com>

# Clé de chiffrement des sauvegardes copiées hors de la machine (créée automatiquement par deploy/sauvegarde_postgres.py --chiffrer) :
# à conserver AUSSI ailleurs, sans elle les copies chiffrées sont illisibles
# SAUVEGARDE_CLE=

# Limites (valeurs par défaut)
LIMITE_CONNEXION=10/minute
LIMITE_SESSION=30/minute
LIMITE_MOT_DE_PASSE=5/minute
LIMITE_ANONYME=60/minute
LIMITE_UTILISATEUR=900/minute
LIMITE_RAPPORT=12/minute
LIMITE_REINITIALISATION=5/hour
LIMITE_REINITIALISATION_VALIDER=10/hour
